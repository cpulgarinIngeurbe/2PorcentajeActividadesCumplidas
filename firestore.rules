rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Acceso valido: cuenta con correo verificado y registro activo en
    // accesos (lo crea el admin). Una cuenta creada por cualquiera desde el
    // login, o un usuario desactivado, no pasa ninguna regla operativa: el
    // control no depende solo de la app.
    function miAcceso() {
      return get(/databases/$(database)/documents/accesos/$(request.auth.token.email)).data;
    }
    function conAcceso() {
      return request.auth != null && request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/accesos/$(request.auth.token.email)) &&
        miAcceso().get('activo', false) == true;
    }
    function esAdmin() {
      return conAcceso() && miAcceso().rol == 'admin';
    }
    // Un contratista es una cuenta externa (no un empleado de Ingeurbe):
    // ve una pantalla aparte, mas chica, y no debe poder leer nada
    // operativo salvo sus propias actividades programadas (via la acta)
    // y subir fotos/videos. Todo lo demas queda vedado para ese rol.
    function noEsContratista() {
      return conAcceso() && miAcceso().rol != 'contratista';
    }
    // Residente SSTA: califica en SSTA a los contratistas de la semana.
    function esSSTA() {
      return conAcceso() && miAcceso().rol == 'ssta';
    }
    // Registrador: programa y califica, y parametriza solo los proyectos
    // de sus entornos (contratistas, equipo administrativo, correos).
    function esRegistrador() {
      return conAcceso() && miAcceso().rol == 'registrador';
    }
    // El proyecto pertenece a alguno de los entornos de la persona
    function proyectoPropio(slug) {
      return exists(/databases/$(database)/documents/proyectos/$(slug)) &&
        get(/databases/$(database)/documents/proyectos/$(slug)).data.get('entornos', []).hasAny(miAcceso().get('entornos', []));
    }
    // Escritura operativa de un proyecto: el admin en todos; los demas roles
    // (no contratista) solo en los proyectos de sus entornos.
    function escribeProyecto(slug) {
      return noEsContratista() && (miAcceso().rol == 'admin' || proyectoPropio(slug));
    }
    // En config por proyecto (mapa slug -> valor): la escritura cambia una
    // sola clave y es de un proyecto propio
    function unSoloProyectoPropio() {
      let cambios = request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys();
      return cambios.size() == 1 && proyectoPropio(cambios.toList()[0]);
    }

    match /accesos/{correo} {
      allow read: if request.auth != null &&
        (request.auth.token.email == correo || esAdmin());
      allow write: if esAdmin();
    }

    match /entornos/{entornoId} {
      allow read: if conAcceso();
      allow write: if esAdmin();
    }

    match /proyectos/{slug} {
      allow read: if conAcceso();
      allow write: if esAdmin();
    }

    match /modelosBIM/{modeloId} {
      allow read: if noEsContratista();
      allow write: if esAdmin();
      match /trozos/{trozoId} {
        allow read: if noEsContratista();
        allow write: if esAdmin();
      }
      // vinculos/{wbs}: elementos del modelo (globalIds) asignados a cada
      // actividad del cronograma (4D BIM). Se guardan aparte del modelo
      // para no reescribirlo completo en cada asignacion.
      match /vinculos/{wbsId} {
        allow read: if noEsContratista();
        allow write: if esAdmin();
      }
    }

    match /cronogramasGenerales/{slug} {
      // El documento principal (nombre del proyecto, total de tareas) es
      // metadata liviana; cualquier autenticado lo puede leer (incluido un
      // contratista, para saber el nombre de sus proyectos). El cronograma
      // completo (los "trozos", el contenido real) no lo necesita un
      // contratista: sus tareas le llegan desde la acta, no desde aqui.
      allow read: if conAcceso();
      allow write: if esAdmin();
      match /trozos/{trozoId} {
        allow read: if noEsContratista();
        allow write: if esAdmin();
      }
    }

    // config/{nombre}: contractors, adminTeam, reasons, units, torres,
    // programacionVisual, notificationEmails, restrictionTypes.
    // Parametrizacion compartida entre proyectos; lectura para cualquier
    // autenticado que no sea contratista. Edicion: el admin todo; el
    // registrador solo contratistas, equipo administrativo y correos, de a
    // un proyecto por escritura y solo de proyectos de sus entornos.
    match /config/{nombre} {
      allow read: if noEsContratista();
      allow write: if esAdmin() ||
        (esRegistrador() && nombre in ['contractors', 'adminTeam', 'notificationEmails'] && unSoloProyectoPropio());
    }

    // actas/{slug}/historial, calificaciones/{slug}/historial,
    // pac/{slug}/historial, restricciones/{slug}/historial: registro
    // operativo (quien programa, califica y reporta restricciones cada
    // semana). Un contratista SI puede leer actas (asi ve sus propias
    // actividades programadas), pero nunca crea una; las demas
    // (calificaciones/pac/restricciones) no las necesita ni leer ni
    // escribir. Nadie puede editar ni borrar un registro ya guardado
    // (historial inmutable, igual que antes cuando vivian como commits en
    // GitHub).
    match /actas/{slug}/historial/{id} {
      allow read: if conAcceso();
      allow create: if escribeProyecto(slug);
      allow update: if false;
      // Solo un administrador puede borrar (no hay boton en la app: se hace
      // por solicitud expresa, p. ej. para reiniciar un proyecto de pruebas)
      allow delete: if esAdmin();
    }
    match /calificaciones/{slug}/historial/{id} {
      allow read: if noEsContratista();
      allow create: if escribeProyecto(slug);
      allow update: if false;
      // Solo un administrador puede borrar (no hay boton en la app: se hace
      // por solicitud expresa, p. ej. para reiniciar un proyecto de pruebas)
      allow delete: if esAdmin();
    }
    match /pac/{slug}/historial/{id} {
      allow read: if noEsContratista();
      allow create: if escribeProyecto(slug);
      allow update: if false;
      // Solo un administrador puede borrar (no hay boton en la app: se hace
      // por solicitud expresa, p. ej. para reiniciar un proyecto de pruebas)
      allow delete: if esAdmin();
    }
    match /restricciones/{slug}/historial/{id} {
      allow read: if noEsContratista();
      allow create: if escribeProyecto(slug);
      allow update: if false;
      // Solo un administrador puede borrar (no hay boton en la app: se hace
      // por solicitud expresa, p. ej. para reiniciar un proyecto de pruebas)
      allow delete: if esAdmin();
    }

    // preregistros/{slug}: borrador de calificacion en curso durante la
    // semana; se reemplaza o se borra al cerrar el avance. Un contratista
    // no califica, no lo necesita.
    match /preregistros/{slug} {
      allow read: if noEsContratista();
      allow write: if escribeProyecto(slug);
    }

    // estadoEjecucion/{slug}: estado acumulado (Programado/Ejecutado/No
    // ejecutado) por casilla de Programacion visual; se actualiza en cada
    // acta y calificacion. No aplica a un contratista.
    match /estadoEjecucion/{slug} {
      allow read: if noEsContratista();
      allow write: if escribeProyecto(slug);
    }

    // actividadesManuales/{slug}/items/{itemId}: actividades fuera del
    // cronograma (no vienen del .mpp). Un contratista no las crea ni las
    // programa.
    match /actividadesManuales/{slug} {
      match /items/{itemId} {
        allow read: if noEsContratista();
        allow write: if escribeProyecto(slug);
      }
    }

    // cantidadesPac/{slug}/items/{itemId}: cantidad total PAC (meta
    // opcional) por actividad del cronograma, identificada por WBS. No
    // aplica a un contratista.
    match /cantidadesPac/{slug} {
      match /items/{itemId} {
        allow read: if noEsContratista();
        allow write: if escribeProyecto(slug);
      }
    }

    // auditoria/{id}: log de quien crea cada registro nuevo (acta,
    // calificacion, pac, restriccion, config, cantidad PAC, actividad
    // manual) y cuando, incluido inicio/cierre de sesion de cualquier rol
    // (tambien contratista). Cualquier autenticado puede crear un registro
    // de auditoria (se genera automaticamente al guardar), pero solo un
    // admin puede leer el log; es inmutable, nadie puede editarlo ni
    // borrarlo.
    match /auditoria/{id} {
      allow read: if esAdmin();
      allow create: if conAcceso();
      allow update, delete: if false;
    }

    // registroFotografico/{slug}/items/{itemId}: fotos y videos de avance
    // de obra. Las fotos las sube la GitHub Action (cuenta de servicio, no
    // pasa por estas reglas); los videos los sube el navegador directo a
    // OneDrive y luego el mismo navegador registra el resultado aqui. Esta
    // es la unica coleccion operativa donde SI se permite escribir a un
    // contratista (es justo lo que puede hacer: subir fotos y videos de
    // sus actividades), por eso "create" queda abierto a cualquier
    // autenticado (nunca editar ni borrar un registro ya guardado).
    match /registroFotografico/{slug} {
      match /items/{itemId} {
        allow read: if conAcceso();
        allow create: if conAcceso();
        allow update, delete: if false;
      }
    }

    // sesionesSubidaVideo/{id}: documento temporal con la URL de subida de
    // Microsoft Graph que crea la GitHub Action para cada video; el
    // navegador (incluido un contratista subiendo un video) solo la lee,
    // para saber cuando empezar a subir. Solo la Action (cuenta de
    // servicio) escribe aqui.
    match /sesionesSubidaVideo/{id} {
      allow read: if conAcceso();
      allow write: if false;
    }

    // leccionesAprendidas/{slug}/items/{id}: lecciones aprendidas de obra
    // por capitulo de la programacion (amenazas, elementos a considerar,
    // soluciones a riesgos materializados). Las registra y consulta el
    // equipo (no un contratista); solo su autor o un admin la edita/borra.
    match /leccionesAprendidas/{slug} {
      match /items/{id} {
        allow read: if noEsContratista();
        allow create: if escribeProyecto(slug);
        allow update, delete: if esAdmin() ||
          (noEsContratista() && resource.data.creadoPor == request.auth.token.email);
      }
    }

    // evaluacionesSSTA/{slug}/historial/{id}: calificacion SSTA de cada
    // contratista (formato FT-SSTA-103). La crea el Residente SSTA (rol
    // "ssta") o un admin; la consulta el equipo; es inmutable.
    match /evaluacionesSSTA/{slug}/historial/{id} {
      allow read: if noEsContratista();
      allow create: if esAdmin() || (esSSTA() && proyectoPropio(slug));
      allow update: if false;
      // Solo un administrador puede borrar (no hay boton en la app: se hace
      // por solicitud expresa, p. ej. para reiniciar un proyecto de pruebas)
      allow delete: if esAdmin();
    }
  }
}
